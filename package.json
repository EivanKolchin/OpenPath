{
  "name": "openpath",
  "private": true,
  "version": "0.1.1",
  "description": "OpenPath — an open intelligence platform for planet Earth. Live 3D globe, place-anchored communities, and multi-source search across the open web and the archives. Forked from God's Eye View by Bilawal Sidhu (MIT).",
  "type": "module",
  "license": "MIT",
  "author": "Eivan Kolchin (https://github.com/EivanKolchin)",
  "contributors": [
    "Bilawal Sidhu (https://github.com/bilawalsidhu)",
    "Sameh Khamis (https://github.com/samehkhamis)"
  ],
  "homepage": "https://github.com/EivanKolchin/gods-eye-view-fork#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/EivanKolchin/gods-eye-view-fork.git"
  },
  "bugs": {
    "url": "https://github.com/EivanKolchin/gods-eye-view-fork/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization",
    "open-source-intelligence",
    "archive-diffing",
    "fork"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  }
}
